NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker
CLIENT_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Set to the shared parent domain in production (for example, .example.com); leave blank locally.
COOKIE_DOMAIN=
# Use "none" if the frontend and API are cross-site; Secure is enabled automatically.
COOKIE_SAME_SITE=lax
